# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real a un repositorio.

# Cadena de conexión a PostgreSQL (driver psycopg v3, no psycopg2 — mejor
# soporte de wheels precompilados en versiones nuevas de Python)
# Formato: postgresql+psycopg://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/control_acceso

# Clave secreta para firmar los tokens JWT del panel administrativo.
# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Minutos de validez del token de sesión del panel
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador inicial (usado solo por seed_db.py). El panel
# obliga a cambiar esta contraseña la primera vez que entra (ver
# debe_cambiar_password en models.Usuario), así que no pasa nada si
# queda con este valor por defecto hasta ese momento.
ADMIN_USUARIO=administrador
ADMIN_PASSWORD=administrador123

# AcademicOK: fuente institucional consultada cuando la persona no existe
# todavía en la base local. Cambiar solo si TI confirma otra URL/API.
ACADEMICOK_URL=https://its.academicok.com/datoscredencial
ACADEMICOK_TIMEOUT=10

# Si una persona ya tiene un movimiento registrado hace menos de estos
# minutos, un nuevo escaneo se responde como "DUPLICADO" (no alterna a
# ENTRADA/SALIDA) -- pensado para cuando alguien no está seguro si ya
# marcó y vuelve a escanear "por si acaso".
MINUTOS_ANTIDUPLICADO_MOVIMIENTO=5

# Orígenes permitidos para llamar a la API (el panel React), separados
# por coma. Vacío/sin definir = se permite cualquier origen ("*"), lo
# cual está bien en desarrollo local pero NO en producción. Ver
# .env.production.example para el valor real a usar en el despliegue.
ALLOWED_ORIGINS=
