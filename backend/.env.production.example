# Plantilla de .env para el despliegue en el servidor de la nube
# (control-acceso.sudamericano.edu.ec). Copia este archivo como ".env"
# EN EL SERVIDOR (no en tu PC) y reemplaza los valores marcados con
# "CAMBIAR". Ver backend/README.md y DESPLIEGUE.md para el paso a paso
# completo.

# Cadena de conexión a la base PostgreSQL de producción. Si Postgres
# corre en el mismo servidor que el backend, host=localhost está bien;
# si es un servicio administrado aparte, usa el host que te dé el
# proveedor.
DATABASE_URL=postgresql+psycopg://CAMBIAR_USUARIO:CAMBIAR_PASSWORD@localhost:5432/control_acceso

# Clave secreta para firmar los tokens JWT -- OBLIGATORIO generar una
# nueva para producción, nunca reutilizar la de desarrollo. Generarla
# con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_por_una_clave_generada_aleatoriamente

# Minutos de validez del token de sesión del panel
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador inicial (usado solo la primera vez, por
# seed_db.py). El panel obliga a cambiarla apenas entres la primera vez
# (ver debe_cambiar_password), así que dejarla en administrador123 acá
# no es un riesgo -- igual, si preferís, poné otra desde ya.
ADMIN_USUARIO=administrador
ADMIN_PASSWORD=administrador123

# AcademicOK: fuente institucional consultada cuando la persona no
# existe todavía en la base local. Cambiar solo si TI confirma otra
# URL/API.
ACADEMICOK_URL=https://its.academicok.com/datoscredencial
ACADEMICOK_TIMEOUT=10

# Marca duplicada (ver README.md / Terminal_QR_y_AcademicOK_Estado.md)
MINUTOS_ANTIDUPLICADO_MOVIMIENTO=5

# El panel React (dashboard) queda en el MISMO subdominio (servido como
# archivos estáticos por Nginx, ver deploy/nginx-control-acceso.conf),
# así que en rigor no haría falta ningún otro origen -- pero se deja
# explícito por si el panel se sirve alguna vez desde otro dominio
# (por ejemplo, para probar antes de apuntar el DNS definitivo).
ALLOWED_ORIGINS=https://control-acceso.sudamericano.edu.ec
