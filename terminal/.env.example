# Copia este archivo como ".env" y ajusta si hace falta.

# URL del backend
API_URL=http://127.0.0.1:8000

# Punto de acceso registrado en el backend (ver tabla puntos_acceso;
# seed_db.py crea el punto id=1 "Entrada principal")
PUNTO_ACCESO_ID=1

# Índice de la cámara (0 = cámara por defecto)
CAMARA_INDICE=0

# Segundos mínimos antes de volver a procesar el mismo QR
TIEMPO_ANTIDUPLICADO=5
