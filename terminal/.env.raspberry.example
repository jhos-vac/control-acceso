# Copia este archivo como ".env" (en la misma carpeta terminal/) y ajusta
# si hace falta. Es el mismo .env que usa leer_qr.py, con variables extra
# para leer_qr_raspberry.py.

# URL del backend. Dos casos:
#   - Backend en la nube (producción, ver DESPLIEGUE.md en la raíz del
#     proyecto): la URL pública HTTPS, SIN "/api" al final -- por ejemplo
#     https://control-acceso.sudamericano.edu.ec -- el terminal ya arma
#     "/api/acceso" por su cuenta. Con esto, la Raspberry ya NO necesita
#     estar en la misma red que el backend, solo tener internet.
#   - Backend local (pruebas, red del edificio sin depender de internet):
#     la IP de esa máquina en la red, por ejemplo http://192.168.1.50:8000
#     -- no uses 127.0.0.1 en ese caso (eso apunta a la propia Raspberry).
API_URL=https://control-acceso.sudamericano.edu.ec

# Clave del terminal: debe ser IGUAL a TERMINAL_API_KEY del .env del backend
# (ver backend/.env.production.example). Con el backend en la nube, sin esta
# clave el backend rechaza los accesos y el latido (401) -- los QR leídos
# quedan en la cola local y se envían solos apenas se corrige. Déjala vacía
# solo si el backend no tiene TERMINAL_API_KEY (pruebas locales).
API_KEY=

# Punto de acceso registrado en el backend (ver tabla puntos_acceso;
# seed_db.py crea el punto id=1 "Entrada principal")
PUNTO_ACCESO_ID=1

# Segundos mínimos antes de volver a procesar el mismo QR
TIEMPO_ANTIDUPLICADO=5

# Cada cuántos segundos el terminal avisa al backend que sigue
# encendido (y recoge la orden de apagado, si el panel la envió)
INTERVALO_LATIDO=15

# --- Específico de leer_qr_raspberry.py ---

# Ruta del lector QR USB de mesa (WD-1012), tal como aparece en
# /dev/input/by-id/ con el lector conectado -- ver README_RASPBERRY.md,
# sección "Encontrar la ruta del lector USB". Es obligatorio: sin esto el
# terminal de Raspberry no tiene forma de leer ningún QR.
SCANNER_DEVICE_PATH=/dev/input/by-id/usb-CAMBIAR_ESTO-event-kbd

# true = la ventana ocupa toda la pantalla táctil (modo kiosco). Déjalo en
# false mientras estás probando/ajustando desde un monitor normal.
PANTALLA_COMPLETA=false

# --- Cola local / envío asíncrono (velocidad + funcionar sin conexión) ---
# Cada QR leído se guarda de inmediato en cola_local.db (SQLite, en esta
# misma carpeta) y se envía al backend en segundo plano, uno por uno --
# así la lectura nunca espera a la red, y si se corta la conexión nada se
# pierde (se manda solo cuando vuelve). Ver README_RASPBERRY.md.

# Timeout (segundos) de cada intento de envío -- corto a propósito: si el
# backend no contesta rápido, es mejor fallar rápido y reintentar que
# quedarse esperando y frenar la cola.
TIMEOUT_ENVIO_SEGUNDOS=5

# Segundos a esperar antes de reintentar cuando no hay conexión.
REINTENTO_SEGUNDOS=8

# Si el terminal estuvo sin conexión y se está poniendo al día mandando
# pendientes acumulados, ya no tiene sentido actualizar la pantalla con el
# resultado de alguien que escaneó hace rato y se fue. Solo se muestra en
# pantalla si el pendiente se leyó hace menos de esto (igual queda bien
# registrado en el backend, solo no se muestra en pantalla).
MOSTRAR_RESULTADO_SEGUNDOS=20

# --- Autonomía / configuración de WiFi desde la pantalla (ver red.py) ---

# Cada cuántos segundos revisa si el dispositivo tiene alguna red activa
# (WiFi o cable). Si no la tiene, la pantalla de espera muestra "SIN
# CONEXIÓN WIFI" y ofrece escanear un código QR de WiFi o tocar el botón
# "Continuar sin conexión". No hace falta bajarlo mucho: perder la red
# unos segundos no afecta nada (comun.hilo_envio ya reintenta solo).
REVISAR_RED_SEGUNDOS=5
